zz_old
zz_old/*

# Claude Code per-machine permission allowlist (paths/hosts are
# AFS-specific, not portable to other collaborators).
.claude/settings.json
output_xsec/ww
output_xsec/ww_*
output_xsec/ww.bak_*
output_xsec/wbwb
fit_output
archive

# report/figs/ holds EXACTLY the PDF figures embedded in
# report/ww_bfs_implementation.pdf — all TRACKED, so the report is self-contained
# and rebuildable without re-running the plot scripts. Nothing else belongs there:
# no PNGs, no unreferenced figures. They are produced directly by
# scripts/make_report_plots.py (PDF only) and mirrored from the untracked plots/
# and fit_output/ working areas by report/publish.sh. PNG previews and every
# non-report plot live under plots/ or fit_output/ (both ignored below), so a
# stray PNG appearing in report/figs/ shows up in `git status` as a reminder.

# Investigation plots (regenerated by scripts/investigations/*/plot_*.py
# scripts into <topic>/<plot>.{png,pdf}). Source scripts ARE tracked.
plots/

# pdflatex / bibtex build artifacts. The .tex source IS tracked; only
# rendered PDF + build artifacts are ignored (PDF published to EOS).
*.aux
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
report/*.pdf
paper/*.pdf
bin
logs
*~
*.log
*.pyc
*.so
*.o

# whizard/ subdirectory holds operational scripts (install.sh, submit.py,
# parse.py, aggregate.py, fixup.py, job.sh). The .sub files there are
# auto-generated by submit.py / fixup.py.
whizard/*.sub

# WHIZARD/VAMP/Fortran artifacts in case they leak into the tree.
*.mod
*.smod
*.la
*.lo
*.phs
*.vg
*.makefile
condor/ww_templates/*.sub

# Independent-WW (MoCaNLO) condor artifacts auto-generated by
# scripts/indep_mocanlo/submit_grid.py (source IS tracked). The σ̂ grid itself
# lives outside the repo in ../mocanlo/grid_gen/ (like the whizard grids).
scripts/indep_mocanlo/*.sub
scripts/indep_mocanlo/points_*.txt

# Kerberos credential cache files (binary, per-user, not portable).
# CERN tooling occasionally drops them in the cwd as <user>.cc.
mdefranc.cc
*.kcache
krb5cc_*
