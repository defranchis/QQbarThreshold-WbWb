zz_old
zz_old/*

# Claude Code per-machine permission allowlist (paths/hosts are
# AFS-specific, not portable to other collaborators).
.claude/settings.json
output_xsec/ww
output_xsec/ww_*
output_xsec/ww.bak_*
output_xsec/wbwb
fit_output
archive

# Plots embedded in report/ww_bfs_implementation.pdf — regenerated by
# scripts/make_report_plots.py and scripts/plot_ww_diagnostics.py.
report/figs/

# Investigation plots (regenerated by scripts/investigations/*/plot_*.py
# scripts into <topic>/<plot>.{png,pdf}). Source scripts ARE tracked.
plots/

# pdflatex / bibtex build artifacts. The .tex source IS tracked; only
# rendered PDF + build artifacts are ignored (PDF published to EOS).
*.aux
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
report/*.pdf
bin
logs
*~
*.log
*.pyc
*.so
*.o

# whizard/ subdirectory holds operational scripts (install.sh, submit.py,
# parse.py, aggregate.py, fixup.py, job.sh). The .sub files there are
# auto-generated by submit.py / fixup.py.
whizard/*.sub

# WHIZARD/VAMP/Fortran artifacts in case they leak into the tree.
*.mod
*.smod
*.la
*.lo
*.phs
*.vg
*.makefile
condor/ww_templates/*.sub

# Kerberos credential cache files (binary, per-user, not portable).
# CERN tooling occasionally drops them in the cwd as <user>.cc.
mdefranc.cc
*.kcache
krb5cc_*
