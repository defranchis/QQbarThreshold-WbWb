zz_old
zz_old/*

# Claude Code per-machine permission allowlist (paths/hosts are
# AFS-specific, not portable to other collaborators).
.claude/settings.json
output_xsec/ww
output_xsec/ww_*
output_xsec/ww.bak_*
output_xsec/wbwb
fit_output
archive

# report/figs/ holds EXACTLY the PDF figures embedded in
# report/ww_bfs_implementation.pdf — all TRACKED, so the report is self-contained
# and rebuildable without re-running the plot scripts. Nothing else belongs there:
# no PNGs, no unreferenced figures. They are produced directly by
# scripts/make_report_plots.py (PDF only) and mirrored from the untracked plots/
# and fit_output/ working areas by report/publish.sh. PNG previews and every
# non-report plot live under plots/ or fit_output/ (both ignored below), so a
# stray PNG appearing in report/figs/ shows up in `git status` as a reminder.
# Likewise report/data/ holds the TRACKED text dumps the report cites (e.g.
# scenario_compare.txt) — mirrored from plots/ by report/publish.sh — so the
# data behind the results tables travels with the report. Both are tracked by
# default (no rule needed); only report/*.pdf (the built PDF) is ignored.

# Generated plots + data dumps (untracked; the source scripts ARE tracked).
# CONVENTION: every producer writes into its OWN plots/<topic>/ subdir — never
# loose at plots/ root. Active producers:
#   plots/scenario_compare/  scenario_compare.py  (--compareScenarios: figs+csv+txt)
#   plots/theory_ladder/     theory_ladder.py     (--theoryLadder: csv+txt)
#   plots/channel_extrap/    channel_extrap.py    (--channelExtrap: csv+txt)
#   plots/nll_isr/           scripts/investigations/nll_isr/plot_isr_comparison.py
#   plots/whizard_grid_highstats/, plots/coulomb_double_count/, plots/indep_mocanlo/
#                            scripts/investigations/<topic>/*.py
# report/publish.sh mirrors the report-figure subset (PDF only) from these into
# the tracked report/figs/. legacy_code/ scripts are dead — do not run them.
plots/

# pdflatex / bibtex build artifacts. The .tex source IS tracked; only
# rendered PDF + build artifacts are ignored (PDF published to EOS).
*.aux
*.out
*.toc
*.bbl
*.blg
*.synctex.gz
*.fls
*.fdb_latexmk
report/*.pdf
paper/*.pdf
bin
logs
*~
*.log
*.pyc
*.so
*.o

# whizard/ subdirectory holds operational scripts (install.sh, submit.py,
# parse.py, aggregate.py, fixup.py, job.sh). The .sub files there are
# auto-generated by submit.py / fixup.py.
whizard/*.sub

# WHIZARD/VAMP/Fortran artifacts in case they leak into the tree.
*.mod
*.smod
*.la
*.lo
*.phs
*.vg
*.makefile
condor/ww_templates/*.sub

# Independent-WW (MoCaNLO) condor artifacts auto-generated by
# scripts/indep_mocanlo/submit_grid.py (source IS tracked). The σ̂ grid itself
# lives outside the repo in ../mocanlo/grid_gen/ (like the whizard grids).
scripts/indep_mocanlo/*.sub
scripts/indep_mocanlo/points_*.txt

# Precomputed eMELA-NLL ISR radiator grids (binary npz + lhagrid1 text set).
# Generated on AFS by scripts/investigations/isr_prewarm_lhapdf/build_production_grid.py
# (tracked); the grid artifact itself is reproducible and stays untracked.
framework/process/ww/indep/grids/

# Kerberos credential cache files (binary, per-user, not portable).
# CERN tooling occasionally drops them in the cwd as <user>.cc.
mdefranc.cc
*.kcache
krb5cc_*

# Local talk/slides scratch (not part of the framework or report).
talk/
scripts/investigations/talk_figs/
